# ---------------------------------------------------------------------------
# Cliq environment variables
# Copy to .env.local for local dev, or set these in Vercel -> Settings -> Env Vars.
# ---------------------------------------------------------------------------

# Neon PostgreSQL (production database).
# Use the POOLED connection string (it contains "-pooler"); serverless needs it.
# Format: postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Session signing key — signs the httpOnly session cookie.
# Generate with: openssl rand -base64 48
CLIQ_SESSION_SECRET=

# Cloudinary direct uploads (browser -> Cloudinary, bypassing Vercel).
# Both are NEXT_PUBLIC_* because the browser performs the upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Must be an UNSIGNED upload preset: Cloudinary dashboard -> Settings -> Upload -> Add upload preset
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Optional ---------------------------------------------------------------
# Set to "no-verify" only if a TLS proxy breaks Neon certificate validation.
# DATABASE_SSL=
# Max Postgres pool size per serverless instance (default 5).
# PG_POOL_MAX=

# --- Legacy: Cloudflare D1 --------------------------------------------------
# D1 is still supported as a fallback when DATABASE_URL is unset, but Neon is
# the intended production database.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
